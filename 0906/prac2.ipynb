    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "我的名字是John\n",
      "我的名字是Mike\n"
     ]
    }
   ],
   "source": [
    "p1:Person = Person(\"John\")\n",
    "p2:Person = Person(name=\"Mike\")\n",
    "\n",
    "p1.introduce()\n",
    "p2.introduce()\n"
   ]
  },
