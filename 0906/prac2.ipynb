   "source": [
    "class Person:\n",
    "    def __init__(self,name:str):\n",
    "        self.name = name #定義實體屬性\n",
    "\n",
    "    def introduce(self): #自訂的實體方法\n",
    "        print(f\"我的名字是{self.name}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "c54606f3-3729-447a-bc46-4a0ed6baac09",
   "metadata": {},
